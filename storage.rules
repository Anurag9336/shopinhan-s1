rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same admin allowlist as firestore.rules — Storage rules can read
    // Firestore directly, so we check the same /admins collection
    // instead of just "is someone logged in" (see firestore.rules for
    // why that distinction matters).
    function isAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Product images — customers need to see these on the shop, so read
    // is public. Only admins can upload/replace/delete.
    match /product-images/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Purchase bills (proof of purchase — supplier invoice photo/PDF).
    // ADMIN-ONLY, both read and write. These are audit documents (GST
    // checking, accounting) and must never be visible to customers or
    // to the public internet.
    match /purchase-bills/{productId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
